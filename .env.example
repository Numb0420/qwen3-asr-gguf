# ==========================================
# Qwen3-ASR GGUF (local Windows)
# conda activate lingting
# python run.py
# ==========================================

# -----------------
# Host / Network
# -----------------
HOST=127.0.0.1
PORT=8765

# -----------------
# Model
# -----------------
MODEL_DIR=./models
LLM_FN=qwen3_asr_llm.q5_k.gguf
ENCODER_FRONTEND_FN=qwen3_asr_encoder_frontend.int8.onnx
ENCODER_BACKEND_FN=qwen3_asr_encoder_backend.int8.onnx
ONNX_PROVIDER=DML
# false = CPU decoder (Vulkan off). Use this to check GGML_ASSERT crashes.
LLM_USE_GPU=true
WS_ASR_TEMPERATURE=0.0
OFFLINE_ASR_TEMPERATURE=0.2
# Load ForcedAligner + offline JSON timestamps. WS finals: WS_FINAL_ALIGN.
ENABLE_ALIGNER=true
ALIGNER_LLM_FN=qwen3_aligner_llm.q5_k.gguf
ALIGNER_FRONTEND_FN=qwen3_aligner_encoder_frontend.int8.onnx
ALIGNER_BACKEND_FN=qwen3_aligner_encoder_backend.int8.onnx
DML_PAD_TO=8
REALTIME_CHUNK_SIZE_SEC=8
FILE_CHUNK_SIZE_SEC=40
OFFLINE_TARGET_CHUNK_SECONDS=35
OFFLINE_SPLIT_SEARCH_SECONDS=5
OFFLINE_MIN_SILENCE_MS=400
OFFLINE_FALLBACK_SILENCE_MS=200
OFFLINE_HARD_CUT_OVERLAP_SECONDS=1.5
OFFLINE_SILENCE_OVERLAP_SECONDS=0.4
OFFLINE_CUT_EPS_SECONDS=0.15

# -----------------
# WebSocket (single session)
# -----------------
# ForcedAligner / chars on WS finals. false skips align so the next partial is not blocked.
WS_FINAL_ALIGN=true
# Clean common hesitation sounds in realtime and offline output; false keeps verbatim text.
ASR_REMOVE_FILLERS=true
WS_PARTIAL_SECONDS=1.5
WS_PARTIAL_WINDOW_SEC=4
WS_MAX_UTTERANCE_SECONDS=20
WS_HARD_CUT_SEARCH_SECONDS=14
WS_HARD_CUT_MIN_SILENCE_MS=300
WS_HARD_CUT_OVERLAP_SECONDS=0.8
WS_VAD_PRE_ROLL_MS=800
WS_VAD_HANGOVER_MS=800
WS_FLUSH_SILENCE_MS=600
WS_EARLY_SILENCE_MS=1000
WS_COMMITTED_SPEECH_SECONDS=0.8
WS_VAD_END_MAX_SILENCE_MS=1200
# Long-utterance soft cuts require a pause and speech resumption; punctuation is not required.
WS_SOFT_CUT_ENABLED=true
WS_SOFT_CUT_START_SECONDS=12
WS_SOFT_CUT_SILENCE_MS=500
WS_SOFT_CUT_LOOKBACK_MS=200
WS_FIXED_ENCODER_WINDOW=false
WS_SHARED_UTT=false
WS_FINAL_YIELD=false
WS_LAZY_PARTIAL=false
ASR_USE_SERVER_VAD=true
VAD_MODEL_PATH=silero_vad.onnx

# Unload after last HTTP/WS activity if no live WebSocket (seconds).
# 0 = never idle-unload (weights stay resident until process exit).
UNLOAD_GRACE_S=0
REQUEST_TIMEOUT=300
OUTPUT_DIR=./outputs

# -----------------
# Logging
# -----------------
LOG_LEVEL=info

GGML_VULKAN=1
# Vulkan FP32 (skip FP16). Test GET_ROWS abort; one flag only.
# GGML_VK_DISABLE_F16=1
