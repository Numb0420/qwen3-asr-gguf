# ==========================================
# Qwen3-ASR Configuration (Environment Variables)
# ==========================================

# -----------------
# Compose & Network
# -----------------
# 0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机
HOST=0.0.0.0
# External port to expose on the host machine
PORT=8765

# -----------------
# Core Behavior
# -----------------
MODEL_ID=Qwen/Qwen3-ASR-1.7B
# 空闲卸载秒数。0 = 常驻，实时结束后立刻离线不必重新加载。
UNLOAD_GRACE_S=0
REQUEST_TIMEOUT=300
# ASR 解码器温度。0 = 贪婪解码（确定性），>0 = 随机采样。
# WebSocket 实时识别用 0：消除随机采样导致的 partial 抖动，每次相同音频输出一致。
WS_ASR_TEMPERATURE=0.0
# 离线文件转录用 0.2：保留少量随机性，配合 retry/rescue 机制提高容错。
OFFLINE_ASR_TEMPERATURE=0.2
# 清理实时字幕和离线结果中的呃/嗯/哎及独立的啊；原始音频与 VAD 不变。
ASR_REMOVE_FILLERS=true

# -----------------
# Local GGUF / ONNX models
# -----------------
# 所有模型文件的根目录（相对路径基于项目根目录，也支持绝对路径）。
# LLM / encoder / aligner / VAD 的文件名都相对这个目录解析。
MODEL_DIR=C:\model16
LLM_FN=qwen3_asr_llm.q8_0.gguf
ENCODER_FRONTEND_FN=qwen3_asr_encoder_frontend.fp16.onnx
ENCODER_BACKEND_FN=qwen3_asr_encoder_backend.fp16.onnx
ONNX_PROVIDER=DML
# -----------------
# ForcedAligner timestamps
# -----------------
# Load aligner + offline JSON chars. WebSocket finals: WS_FINAL_ALIGN.
ENABLE_ALIGNER=true
ALIGNER_LLM_FN=qwen3_aligner_llm.q8_0.gguf
ALIGNER_FRONTEND_FN=qwen3_aligner_encoder_frontend.fp16.onnx
ALIGNER_BACKEND_FN=qwen3_aligner_encoder_backend.fp16.onnx

ASR_USE_SERVER_VAD=true
VAD_MODEL_PATH=silero_vad.onnx

# -----------------
# Logging
# -----------------
LOG_LEVEL=INFO
# 日志文件目录，默认 vendor/logs（相对路径基于项目根目录，也支持绝对路径）
LOG_DIR=./logs

# ONNX encoder 单次推理的最大音频块（秒）。
# REALTIME 用于 WebSocket 实时流式分块；FILE 用于离线文件转写的硬切上限。
# DML_PAD_TO 默认跟随 REALTIME_CHUNK_SIZE_SEC，DirectML 需固定 shape 时可显式覆盖。
REALTIME_CHUNK_SIZE_SEC=8
FILE_CHUNK_SIZE_SEC=40
# 固定 8 秒窗 + 句内共享 embedding。final 复用满窗，decode 仍整句重来。
WS_FIXED_ENCODER_WINDOW=true
WS_SHARED_UTT=true
WS_FINAL_YIELD=true
WS_LAZY_PARTIAL=false

# -----------------
# WebSocket Streaming
# -----------------
# ForcedAligner / chars on WS finals. false = faster finals, no chars.
WS_FINAL_ALIGN=false
WS_PARTIAL_SECONDS=1.2
# Partial only. Re-decode the current growing block on every refresh;
# commit it at 8s, then start a new block with no PCM overlap.
# The open block replaces its prior text. Finals still use the full utterance.
WS_PARTIAL_WINDOW_SEC=8
WS_MAX_UTTERANCE_SECONDS=20
# On the hard-cut limit, search this much audio for a VAD silence boundary first.
WS_HARD_CUT_SEARCH_SECONDS=14
WS_HARD_CUT_MIN_SILENCE_MS=300
WS_HARD_CUT_OVERLAP_SECONDS=0.8
# VAD 静音阈值：检测到 N ms 静音即认为"说完了"（speech_ended）
WS_FLUSH_SILENCE_MS=800
# 短句的静音阈值，比 FLUSH 更保守，避免误切
WS_EARLY_SILENCE_MS=1000
# 发言短于此时长用 EARLY_SILENCE，否则用 FLUSH_SILENCE
WS_COMMITTED_SPEECH_SECONDS=0.8
# speech_ended 后的续说观察窗口：窗口内恢复说话则续用当前 utterance；超时才 final（不受 partial 标点提前结束）
WS_VAD_END_MAX_SILENCE_MS=600
# Fresh onset ring (skip/hangover_discard). Not previous-turn overlap.
WS_VAD_PRE_ROLL_MS=800
# VAD 结束后继续收这段 PCM，用于判定是真结束还是短停顿
WS_VAD_HANGOVER_MS=800
# soft_cut：长发言中遇到较长自然停顿时提前切段；句末标点是辅助判断，不是必需条件。
WS_SOFT_CUT_ENABLED=true
WS_SOFT_CUT_START_SECONDS=12
WS_SOFT_CUT_SILENCE_MS=500
WS_SOFT_CUT_LOOKBACK_MS=200

# -----------------
# Hardware Acceleration & Quantization
# -----------------
LLM_USE_GPU=true
# Vulkan FP16 A/B: force FP32. One flag only.
#GGML_VK_DISABLE_F16=1
QUANTIZE=
# e.g., 'int8', 'fp8'
USE_CUDA_GRAPHS=false

# -----------------
# Hotword Correction (音素级热词纠错)
# -----------------
# 基于 RAG 音素编辑距离，把 ASR 识别错的词替换为热词表中的词。
# 在 ITN 之后、emit/JSON 之前执行，时间戳由 sync_words_from_text 合并。
# 关闭可设 HOTWORD_ENABLED=false
HOTWORD_ENABLED=true
# 热词文件路径，默认项目根目录 hotwords.txt，每行一个热词（| 分隔别名，~~~ 分隔黑名单）
HOTWORDS_PATH=./hotwords.txt
# 匹配阈值 0~1，越高越严格（默认 0.85）
HOTWORD_THRESHOLD=0.85

# -----------------
# Offline Output (离线转写结果保存)
# -----------------
# 是否将离线转写结果 JSON 保存到本地磁盘。
# true：保存到 OUTPUT_DIR/<task_id>/<文件名>.json，并记录到 task.files.json
# false：结果仅保留在内存（task.result），通过 API 返回，不写磁盘
OFFLINE_SAVE_RESULT=true
# 离线转写结果与上传音频的存放目录（相对路径基于项目根目录，也支持绝对路径）
OUTPUT_DIR=outputs

# -----------------
# Docker / CUDA
# -----------------
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
